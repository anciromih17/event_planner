# SQLite file; the default is event_planner.db in the project directory.
DATABASE_URL=sqlite:///./event_planner.db
# Google OAuth files. On Render, use /etc/secrets/credentials.json and
# /etc/secrets/token.json via Secret Files instead of committing them to Git.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json
# Daily refresh is fixed at 04:00 Europe/Ljubljana in app/scheduler.py.
